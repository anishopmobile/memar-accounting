# Uploaded files must only be served as static images.
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)\.(php[0-9]*|phtml|phar|cgi|pl|py|sh|exe|html?|svg|js)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
